{
  "name": "school-library",
  "version": "1.1.1",
  "description": "幼兒園圖書借閱系統（區域網路版）",
  "license": "MIT",
  "author": "sepal",
  "repository": {
    "type": "git",
    "url": "https://github.com/sepal1111/school-library.git"
  },
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "vendor": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "build:exe:win": "node scripts/build-exe.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "release:win": "node scripts/build-exe.mjs && node scripts/smoke-test.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@yao-pkg/pkg": "^6.22.0",
    "@zxing/library": "^0.21.3",
    "esbuild": "^0.25.12",
    "jsbarcode": "^3.11.6",
    "pngjs": "^7.0.0",
    "resedit": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
